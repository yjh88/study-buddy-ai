# ===== 필수 =====
# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Firebase 서비스 계정 키: 키 파일 경로 또는 JSON 문자열 전체(한 줄)
#  - 로컬: FIREBASE_SERVICE_ACCOUNT_JSON=./serviceAccountKey.json
#  - Render: 키 JSON 내용 전체를 값으로 붙여넣기
FIREBASE_SERVICE_ACCOUNT_JSON=./serviceAccountKey.json

# CORS 허용 도메인 (쉼표 구분, 끝 슬래시 없이)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app

# ===== 선택 =====
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=600
# auto | firestore | memory  (auto: Firebase 키가 있으면 firestore, 없으면 메모리+샘플데이터)
DB_BACKEND=auto
CHAT_RATE_LIMIT_PER_MIN=10
CHAT_HISTORY_LIMIT=10
